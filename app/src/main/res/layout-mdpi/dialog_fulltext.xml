<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_my_answer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/fl_layout"
            android:layout_width="880dp"
            android:layout_height="480dp"
            android:background="@drawable/recording_dialog_background"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="48dp"
                android:fontFamily="@font/notosans_kr_r"
                android:gravity="center"
                android:lineHeight="59sp"
                android:text="@string/text_my_answer"
                android:textAlignment="center"
                android:textColor="#333333"
                android:textSize="40sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/tv_content"
                android:layout_width="740dp"
                android:layout_height="300dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="135dp"
                android:autoSizeMaxTextSize="40sp"
                android:autoSizeMinTextSize="20sp"
                android:autoSizeStepGranularity="2sp"
                android:autoSizeTextType="uniform"
                android:background="@drawable/bg_full_text"
                android:fontFamily="@font/notosans_kr_b"
                android:gravity="center_vertical"
                android:lineHeight="43sp"
                android:maxLines="5"
                android:paddingTop="35dp"
                android:paddingEnd="20dp"
                android:paddingStart="20dp"
                android:textColor="#333333"
                android:textStyle="normal" />

            <ImageView
                android:id="@+id/iv_cancel"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="32dp"
                android:layout_marginEnd="32dp"
                android:background="@android:drawable/ic_menu_close_clear_cancel"/>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/fl_speech_status"
            android:layout_width="600dp"
            android:layout_height="60dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="175dp"
            android:background="@drawable/bg_speech_status"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="32dp"
                android:src="@drawable/icon_listen_active" />

            <TextView
                android:id="@+id/tv_speech"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="52dp"
                android:autoSizeMaxTextSize="35sp"
                android:autoSizeMinTextSize="23sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/notosans_kr_r"
                android:gravity="center"
                android:lineSpacingExtra="12sp"
                android:textColor="#f66e35" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>