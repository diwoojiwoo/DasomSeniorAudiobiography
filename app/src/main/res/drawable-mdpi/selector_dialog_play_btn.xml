<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 비활성화 상태 -->
    <item android:state_enabled="false" android:drawable="@drawable/btn_dialog_rec_play_inactive" />

    <!-- 눌렀을 때 (pressed) -->
    <item android:state_pressed="true" android:drawable="@drawable/btn_dialog_rec_play_active_pressed" />

    <!-- 기본 상태 -->
    <item android:drawable="@drawable/btn_dialog_rec_play_active" />
</selector>